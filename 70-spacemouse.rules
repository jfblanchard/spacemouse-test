# 3Dconnexion SpaceMouse Compact (idVendor 256f, idProduct c635)
# uaccess grants device access to the user logged into the console seat —
# no `input` group membership or logout required.
# Must sort BEFORE 73-seat-late.rules: that is where the uaccess tag is
# turned into a user ACL. A 9x-numbered rule tags the device too late.
# Apply with:
#   sudo cp /mnt/data/hobby/spacemouse-test/70-spacemouse.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
KERNEL=="event*", ATTRS{idVendor}=="256f", ATTRS{idProduct}=="c635", \
  TAG+="uaccess", TAG+="udev-acl"
